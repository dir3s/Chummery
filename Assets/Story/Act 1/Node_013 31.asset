  background: {fileID: -4178046375966092550, guid: d584aa2cad691ab47a1870a2b85b2fff, type: 3}
  dialogueText: "\u041E, 292-\u0442\u0430? \u041E\u0446\u0435 \u0442\u043E\u0431\u0456
    \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E. \u0422\u0432\u043E\u044F
    \u0441\u0443\u0441\u0456\u0434\u043A\u0430 \u2014 \u0449\u0435 \u0442\u0430 \u0448\u0442\u0443\u0447\u043A\u0430!
    \u0412\u043E\u043D\u0430 \u0442\u0443\u0442 \u043D\u0430\u0447\u0435 \u043C\u0456\u0441\u0446\u0435\u0432\u0430
    \u043F\u0430\u043C'\u044F\u0442\u043A\u0430, \u0442\u0456\u043B\u044C\u043A\u0438
    \u0442\u0440\u043E\u0445\u0438 \u043C\u043E\u0442\u043E\u0440\u043E\u0448\u043D\u0430...\n\n\u041A\u0456\u043C\u043D\u0430\u0442\u0430
    \u0442\u0432\u043E\u044F \u044F\u043A\u0440\u0430\u0437 \u043D\u0430\u0434\u0456
    \u043C\u043D\u043E\u044E, \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C\u0443
    \u043F\u043E\u0432\u0435\u0440\u0441\u0456. \u0425\u043E\u0434\u0456\u043C\u043E,
    \u044F\u043A\u0440\u0430\u0437 \u043F\u0440\u043E\u0432\u0435\u0434\u0443 \u0442\u0435\u0431\u0435
    \u0434\u043E \u0441\u0445\u043E\u0434\u0456\u0432, \u043F\u043E\u043A\u0438 \u0449\u0435
    \u0448\u0442\u0430\u043D\u0446\u0456 \u0441\u0443\u0445\u0456!"
