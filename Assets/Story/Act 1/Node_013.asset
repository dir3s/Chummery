  background: {fileID: 6904444990699376935, guid: 871fd644bb4f76b4baa75a6e8f90e814, type: 3}
  dialogueText: "\u0410\u043B\u044F: \u2014 \u041E, \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439?
    \u0427\u043E\u0433\u043E \u0442\u0430\u043A\u0438\u0439 \u043D\u0430\u043B\u044F\u043A\u0430\u043D\u0438\u0439?
    \u0422\u0430 \u043D\u0435 \u043F\u0435\u0440\u0435\u0439\u043C\u0430\u0439\u0441\u044F,
    \u0446\u0435 \u043C\u0456\u0441\u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043B\u044E\u0431\u0438\u0442\u044C \u0432\u0440\u0430\u0436\u0430\u0442\u0438
    \u0433\u043E\u0441\u0442\u0435\u0439. \u042F \u0410\u043B\u044F."
  choices:
  - answerText: "\u042F \u0448\u0443\u043A\u0430\u044E 213-\u0442\u0443 \u043A\u0456\u043C\u043D\u0430\u0442\u0443.
      \u042F\u043A \u043C\u0435\u043D\u0456 \u0442\u0443\u0434\u0438 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438?"
    nextNode: {fileID: 11400000, guid: b8d3c49ef76895b4da2c2529d2c64107, type: 2}
  - answerText: "\u0429\u043E \u0446\u0435 \u0437\u0430 \u0434\u0438\u0432\u043D\u0456
      \u0437\u0432\u0443\u043A\u0438 \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0456?"
    nextNode: {fileID: 11400000, guid: fd7ba5b330d653d44b4d4be6e6934abd, type: 2}
  - answerText: "\u0422\u0438 \u0434\u0430\u0432\u043D\u043E \u0442\u0443\u0442 \u0436\u0438\u0432\u0435\u0448?"
    nextNode: {fileID: 11400000, guid: fc462cd40aa4abc4aa4deafd265bdc92, type: 2}
  nextLinearNode: {fileID: 0}
