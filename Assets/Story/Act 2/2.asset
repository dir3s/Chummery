  background: {fileID: -5750353039905602045, guid: 82e71c26e68a1d047b0b9720f0e5a261, type: 3}
  dialogueText: "\u0421\u0442\u0456\u043D\u0438 \u0442\u0443\u0442 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u044E\u0442\u044C
    \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0433\u0456\u0440\u0448\u0435,
    \u043D\u0456\u0436 \u043D\u0430 \u043F\u0435\u0440\u0448\u043E\u043C\u0443 \u043F\u043E\u0432\u0435\u0440\u0441\u0456:
    \u0448\u0430\u0440\u0438 \u0441\u0442\u0430\u0440\u043E\u0457 \u0444\u0430\u0440\u0431\u0438
    \u0437\u043B\u0456\u0437\u043B\u0438 \u043A\u043B\u0430\u043F\u0442\u044F\u043C\u0438,
    \u043E\u0433\u043E\u043B\u044E\u044E\u0447\u0438 \u0449\u0435 \u0434\u0430\u0432\u043D\u0456\u0448\u0456
    \u043F\u043E\u043A\u0440\u0438\u0442\u0442\u044F, \u0430 \u043C\u0456\u0441\u0446\u044F\u043C\u0438
    \u0432\u0438\u0434\u043D\u043E \u043F\u043E\u0436\u043E\u0432\u043A\u043B\u0456
    \u0433\u0430\u0437\u0435\u0442\u0438, \u044F\u043A\u0438\u043C\u0438 \u043A\u043E\u043B\u0438\u0441\u044C
    \u0437\u0430\u043A\u043B\u0435\u044E\u0432\u0430\u043B\u0438 \u0434\u0456\u0440\u043A\u0438.
    \n\u041F\u0430\u0445\u043D\u0435 \u043F\u0430\u043F\u0435\u0440\u043E\u0432\u0438\u043C
    \u043F\u0438\u043B\u043E\u043C \u0456 \u0447\u0438\u043C\u043E\u0441\u044C \u0441\u043E\u043B\u043E\u0434\u043A\u0443\u0432\u0430\u0442\u043E-\u043D\u0443\u0434\u043E\u0442\u043D\u0438\u043C..."
