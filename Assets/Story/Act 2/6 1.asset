  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0437\u0430\u0440\u0430\u0437
    \u043D\u0430 \u043F\u0456\u0434\u0440\u043E\u0431\u0456\u0442\u043A\u0430\u0445,
    \u043A\u0443\u0440'\u0454\u0440\u044F\u0442\u044C \u0447\u0438 \u0432 \u043A\u043E\u043B-\u0446\u0435\u043D\u0442\u0440\u0430\u0445
    \u0441\u0438\u0434\u044F\u0442\u044C, \u0430 \u0456\u043D\u0448\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
    \u2014 \u0434\u043E \u0435\u043A\u0437\u0430\u043C\u0435\u043D\u0456\u0432 \u0433\u043E\u0442\u0443\u0454\u0442\u044C\u0441\u044F,
    \u0437\u0443\u0431\u0440\u044F\u0442\u044C \u0442\u0430\u043A, \u0449\u043E \u0430\u0436
    \u043C\u0456\u0437\u043A\u0438 \u0437\u0430\u043A\u0438\u043F\u0430\u044E\u0442\u044C.
    \n\u0413\u0443\u0440\u0442\u043E\u0436\u0438\u0442\u043E\u043A \u043E\u0436\u0438\u0432\u0430\u0454
    \u0431\u043B\u0438\u0436\u0447\u0435 \u0434\u043E \u0432\u0435\u0447\u043E\u0440\u0430,
    \u0430 \u0437\u0430\u0440\u0430\u0437 \u0442\u0443\u0442 \u0433\u043E\u0434\u0438\u043D\u0430
    \u043C\u0435\u0440\u0442\u0432\u043E\u0457 \u0442\u0438\u0448\u0456..."
