  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u0420\u0430\u0434\u0456\u0439 \u0446\u0456\u0439 \u0442\u0438\u0448\u0456,
    \u043F\u043E\u043A\u0438 \u0432\u043E\u043D\u0430 \u0454. \u041A\u043E\u043B\u0438
    \u0432\u0441\u0456 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u0437 \u0440\u043E\u0431\u043E\u0442\u0438 \u0430\u0431\u043E \u0432\u0456\u0434\u0456\u0440\u0432\u0443\u0442\u044C\u0441\u044F
    \u0432\u0456\u0434 \u043A\u043E\u043D\u0441\u043F\u0435\u043A\u0442\u0456\u0432
    \u2014 \u0442\u0443\u0442 \u0431\u0443\u0434\u0435 \u0442\u0430\u043A\u0438\u0439
    \u0434\u0443\u0440\u0434\u043E\u043C, \u0449\u043E \u0442\u0438 \u0446\u0456
    \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u0456 \u0445\u0432\u0438\u043B\u0438\u043D\u0438
    \u0437\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438\u043C\u0435\u0448 \u044F\u043A
    \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0435, \u0449\u043E \u0437 \u0442\u043E\u0431\u043E\u044E
    \u0442\u0440\u0430\u043F\u0438\u043B\u043E\u0441\u044F \u0437\u0430 \u0434\u0435\u043D\u044C."
