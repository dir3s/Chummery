  dialogueText: "\u0422\u0430 \u0442\u043E \u0449\u043E\u0431 \u0434\u0456\u0440\u043A\u0438
    \u0432 \u0441\u0442\u0456\u043D\u0430\u0445 \u0456 \u043F\u043B\u0456\u0441\u043D\u044F\u0432\u0443
    \u043F\u0440\u0438\u043A\u0440\u0438\u0442\u0438. \u0420\u0435\u043C\u043E\u043D\u0442\u0443
    \u0442\u0443\u0442 \u043D\u0435 \u0431\u0443\u043B\u043E \u0449\u0435 \u0437
    \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u044F,
    \u043E\u0442 \u0456 \u043B\u0456\u043F\u043B\u044F\u0442\u044C \u043C\u0430\u043A\u0443\u043B\u0430\u0442\u0443\u0440\u0443,
    \u0449\u043E\u0431 \u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u043A\u0430
    \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0443 \u043D\u0435 \u0441\u0438\u043F\u0430\u043B\u0430\u0441\u044F.
    \n\u042F\u043A\u0449\u043E \u043F\u043E\u0447\u043D\u0435\u0448 \u0437\u0434\u0438\u0440\u0430\u0442\u0438
    \u2014 \u0441\u0442\u0456\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u043E\u0437\u0432\u0430\u043B\u0438\u0442\u044C\u0441\u044F."
