  speakerName: "\u0410\u043B\u044F"
  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u0406, \u0434\u043E \u0440\u0435\u0447\u0456, \u0437 \u0446\u0438\u043C\u0438
    \u0433\u0430\u0437\u0435\u0442\u0430\u043C\u0438 \u044F\u043A\u0440\u0430\u0437
    \u0454 \u043E\u0434\u043D\u0430 \u0446\u0456\u043A\u0430\u0432\u0430 \u0456\u0441\u0442\u043E\u0440\u0456\u044F.\n\n\u0425\u043E\u0447\u0435\u0448,
    \u0440\u043E\u0437\u043A\u0430\u0436\u0443?"
  choices:
  - answerText: "\u0422\u0430 \u043D\u0456, \u044F\u043A\u043E\u0441\u044C \u043D\u0435
      \u0434\u0443\u0436\u0435 \u0445\u043E\u0447\u0443"
    nextNode: {fileID: 11400000, guid: 587e588753b0d7a4490dd93597e182b7, type: 2}
  - answerText: "\u0414\u0430\u0432\u0430\u0439, \u0440\u043E\u0437\u043A\u0430\u0437\u0443\u0439,
      \u0449\u043E \u0442\u0430\u043C \u0437\u0430 \u0456\u0441\u0442\u043E\u0440\u0456\u044F"
    nextNode: {fileID: 11400000, guid: be8442fa22a60ca4a95a1d655cc0a76f, type: 2}
  nextLinearNode: {fileID: 0}
