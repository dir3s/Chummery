  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u041A\u043E\u0440\u043E\u0442\u0448\u0435, \u0442\u0438\u0436\u0434\u0435\u043D\u044C
    \u0442\u043E\u043C\u0443 \u0432\u043E\u043D\u0430 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
    \u0437\u0435\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u0438 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438,
    \u0449\u043E \u0432\u0438\u043A\u0440\u0443\u0442\u0438\u043B\u0430 \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0456
    \u043E\u0441\u0442\u0430\u043D\u043D\u044E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0443
    \u043B\u0430\u043C\u043F\u0443 \u0456 \u0432\u043A\u0440\u0443\u0442\u0438\u043B\u0430
    \u0442\u0443\u0434\u0438\u2026 \u0443\u043B\u044C\u0442\u0440\u0430\u0444\u0456\u043E\u043B\u0435\u0442\u043E\u0432\u0443,
    \u044F\u043A\u0443 \u0434\u0435\u0441\u044C \u0443 \u0441\u0432\u043E\u0457\u0439
    \u043A\u043E\u043C\u0456\u0440\u0446\u0456 \u0432\u0456\u0434\u043A\u043E\u043F\u0430\u043B\u0430.
    \n\u0429\u0435 \u0439 \u043A\u0430\u0436\u0435: \xAB\u0422\u043E \u0434\u043B\u044F
    \u0434\u0435\u0437\u0456\u043D\u0444\u0435\u043A\u0446\u0456\u0457\xBB."
