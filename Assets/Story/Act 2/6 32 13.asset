  dialogueText: "\u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E \xAB\u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E\xBB
    \u043E\u0434\u043D\u043E\u043C\u0443 \u0437 211-\u0457, \u0446\u0435 \u044F\u043A\u0440\u0430\u0437
    \u043F\u043E\u0440\u0443\u0447 \u0456\u0437 \u0442\u0432\u043E\u0454\u044E \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u044E
    \u043A\u0456\u043C\u043D\u0430\u0442\u043E\u044E. \u0423 \u043D\u044C\u043E\u0433\u043E
    \u0456 \u0442\u0430\u043A \u0437\u0456\u0440 \u043D\u0456 \u0434\u043E \u0431\u0456\u0441\u0430
    \u2014 \u043B\u0456\u043D\u0437\u0438 \u0432 \u043E\u043A\u0443\u043B\u044F\u0440\u0430\u0445
    \u0442\u0430\u043A\u0456 \u0442\u043E\u0432\u0441\u0442\u0456, \u044F\u043A \u0441\u043A\u043B\u043E
    \u043D\u0430 \u043F\u0456\u0448\u043E\u0445\u0456\u0434\u043D\u043E\u043C\u0443
    \u043C\u043E\u0441\u0442\u0456 \u0432 \u041A\u0438\u0454\u0432\u0456.\n\u0422\u0430\u043A
    \u0432\u0456\u043D, \u043F\u043E\u043A\u0438 \u0434\u043E \u0442\u0438\u0445
    \u0441\u0445\u043E\u0434\u0438\u043D\u043E\u043A \u0443 \u043D\u0430\u043F\u0456\u0432\u0442\u0435\u043C\u0440\u044F\u0432\u0456
    \u0434\u043E\u0447\u043E\u0432\u0433\u0430\u0432, \u043C\u0430\u0439\u0436\u0435
    \u0431\u0435\u0437 \u0437\u0443\u0431\u0456\u0432 \u0437\u0430\u043B\u0438\u0448\u0438\u0432\u0441\u044F
    \u2014 \u0433\u0435\u043F\u043D\u0443\u0432\u0441\u044F \u0442\u0430\u043A, \u0449\u043E
    \u043B\u0435\u0434\u044C \u043E\u043A\u0443\u043B\u044F\u0440\u0438 \u0432 \u0456\u043D\u0448\u0438\u0439
    \u043A\u0456\u043D\u0435\u0446\u044C \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443
    \u043D\u0435 \u043F\u043E\u043B\u0435\u0442\u0456\u043B\u0438... "
