  speakerName: "\u0410\u043B\u044F"
  background: {fileID: -5622901713081898559, guid: 9551ec6647b71f24685fda502436bdcb, type: 3}
  dialogueText: "\u0412\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F, \u0449\u043E
    \u043F\u0456\u0434 \u0448\u0430\u0440\u0430\u043C\u0438 \u0444\u0430\u0440\u0431\u0438
    \u0456 \u0446\u0438\u0445 \u043E\u0431\u0434\u0435\u0440\u0442\u0438\u0445 \u0433\u0430\u0437\u0435\u0442
    \u0447\u0443\u0434\u043E\u0432\u043E \u0432\u0438\u0434\u043D\u043E \u0432\u0441\u0435,
    \u0449\u043E \u043F\u0440\u043E \u043D\u0435\u0457 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u0438
    \u0440\u043E\u043A\u0430\u043C\u0438 \u043D\u0430 \u0441\u0442\u0456\u043D\u0430\u0445
    \u0448\u043A\u0440\u044F\u0431\u0430\u043B\u0438. \u041E\u0434\u0440\u0430\u0437\u0443
    \u0437\u0430\u0431\u0456\u0433\u0430\u043B\u0430, \u043C\u043E\u0432\u043B\u044F\u0432:
    \xAB\u0412\u0436\u0435 \u0432\u0441\u0435 \u043F\u0440\u043E\u0434\u0438\u0437\u0435\u043D\u0444\u0456\u043A\u0443\u0432\u0430\u043B\u0438\xBB,
    \u0456 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430 \u0442\u043E\u0439
    \u0434\u043E\u0445\u043B\u0438\u0439 \u0436\u043E\u0432\u0442\u0438\u0439 \u0432\u043E\u0433\u043D\u0438\u043A,
    \u0449\u043E\u0431 \u043C\u0438 \u0434\u0430\u043B\u0456 \u0432 \u043D\u0430\u043F\u0456\u0432\u0442\u0435\u043C\u0440\u044F\u0432\u0456
    \u043E\u0447\u0456 \u043B\u0430\u043C\u0430\u043B\u0438."
