  m_Script: {fileID: 11500000, guid: ba63bcbb05a29ce4fa79d24819a76077, type: 3}
  m_Name: 6 32
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  speakerName: "\u0410\u043B\u044F"
  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u0412\u043E\u043D\u0430 \u0435\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C
    \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u043D\u0430 \u0432\u0441\u044C\u043E\u043C\u0443,
    \u043D\u0430 \u0447\u043E\u043C\u0443 \u0442\u0456\u043B\u044C\u043A\u0438 \u043C\u043E\u0436\u0435. 
    \u0414\u043E \u0440\u0435\u0447\u0456, \u0437 \u0446\u0456\u0454\u044E \u0457\u0457
    \u0436\u0430\u0434\u0456\u0431\u043D\u0456\u0441\u0442\u044E \u0431\u0443\u043B\u0430
    \u043E\u0434\u043D\u0430 \u0442\u0440\u0435\u0448\u043E\u0432\u0430 \u0456\u0441\u0442\u043E\u0440\u0456\u044F
    \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E \u0442\u0438\u0436\u043D\u044F\u2026
    \n\u0425\u043E\u0447\u0435\u0448 \u0440\u043E\u0437\u043A\u0430\u0436\u0443?"
  choices:
  - answerText: "\u0414\u0430\u0432\u0430\u0439, \u0440\u043E\u0437\u043A\u0430\u0437\u0443\u0439,
      \u0449\u043E \u0442\u0430\u043C \u0437\u0430 \u0456\u0441\u0442\u043E\u0440\u0456\u044F."
    nextNode: {fileID: 11400000, guid: 3f28e8e8f36be514690b61bc5d50b37e, type: 2}
  - answerText: "\u0422\u0430 \u043D\u0456, \u0432 \u043C\u0435\u043D\u0435 \u044F\u043A\u043E\u0441\u044C
      \u043D\u0430\u0441\u0442\u0440\u0456\u0439 \u043D\u0435 \u0434\u043B\u044F
      \u0456\u0441\u0442\u043E\u0440\u0456\u0439."
    nextNode: {fileID: 11400000, guid: 587e588753b0d7a4490dd93597e182b7, type: 2}
  nextLinearNode: {fileID: 0}
