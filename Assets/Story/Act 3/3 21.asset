  dialogueText: "\u041F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E \u0437 \u043D\u0438\u043C\u0438,
    \u0446\u0435\u0439 \u043F\u043E\u0432\u0435\u0440\u0445 \u2014 \u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
