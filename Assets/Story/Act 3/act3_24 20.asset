  dialogueText: "\u042F \u043F\u0440\u0438\u0454\u043C\u043D\u0430 \u043B\u0438\u0448\u0435
    \u0437 \u0442\u0438\u043C\u0438, \u0445\u0442\u043E \u0432\u0430\u0440\u0442\u0438\u0439
    \u043C\u043E\u0454\u0457 \u0443\u0432\u0430\u0433\u0438. \u0410 \u0432\u0456\u0434
    \u0442\u0435\u0431\u0435 \u0432\u0456\u0454 \u0442\u0430\u043A\u043E\u044E \u043F\u043E\u0440\u043E\u0436\u043D\u0435\u0447\u0435\u044E
    \u0442\u0430 \u043F\u0440\u0438\u043C\u0456\u0442\u0438\u0432\u043D\u0438\u043C
    \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u043C \u0437\u0434\u0430\u0432\u0430\u0442\u0438\u0441\u044F
    \u0446\u0456\u043A\u0430\u0432\u0438\u043C, \u0449\u043E \u043C\u0435\u043D\u0456
    \u0441\u0442\u0430\u0454 \u043D\u0443\u0434\u043D\u043E \u043D\u0430\u0432\u0456\u0442\u044C
    \u0434\u0438\u0445\u0430\u0442\u0438 \u0437 \u0442\u043E\u0431\u043E\u044E \u043E\u0434\u043D\u0438\u043C
    \u043F\u043E\u0432\u0456\u0442\u0440\u044F\u043C."
