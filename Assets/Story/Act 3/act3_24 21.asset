  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u0429\u0435 \u043E\u0434\u043D\u0430 \u0442\u0432\u043E\u044F \u0440\u0435\u043F\u043B\u0456\u043A\u0430
    \u2014 \u0456 \u0410\u043B\u0456 \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F
    \u0448\u0443\u043A\u0430\u0442\u0438 \u0441\u043E\u0431\u0456 \u0456\u043D\u0448\u0438\u0439
    \u043E\u0431'\u0454\u043A\u0442 \u0434\u043B\u044F \u0431\u043B\u0430\u0433\u043E\u0434\u0456\u0439\u043D\u043E\u0441\u0442\u0456.
    \u041F\u043E\u0432\u0456\u0440, \u044F \u0432\u043C\u0456\u044E \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0443\u0432\u0430\u0442\u0438
    \u043B\u044E\u0434\u0435\u0439 \u0443 \u0442\u043E\u043C\u0443, \u0449\u043E
    \u0434\u0435\u044F\u043A\u0435 \u0441\u0443\u0441\u0456\u0434\u0441\u0442\u0432\u043E...
    \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0435
    \u0434\u043B\u044F \u0437\u0434\u043E\u0440\u043E\u0432'\u044F."
