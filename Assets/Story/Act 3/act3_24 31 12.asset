  nodeID: 
  speakerName: "\u041C\u0456\u0442\u0430"
  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u0420\u0430\u0434\u0436\u0443 \u0442\u043E\u0431\u0456 \u0446\u0456\u043D\u0443\u0432\u0430\u0442\u0438
    \u0437\u0430\u0445\u0438\u0441\u0442 \u0410\u043B\u0456, \u0431\u043E \u0431\u0435\u0437
    \u043D\u0435\u0457 \u0442\u0438 \u0431 \u0443\u0436\u0435 \u0434\u0430\u0432\u043D\u043E
    \u0432\u0456\u0434\u0447\u0443\u0432, \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
    \"\u0437\u0430\u0442\u0438\u0448\u043D\u0438\u043C\" \u043C\u043E\u0436\u0435
    \u0431\u0443\u0442\u0438 \u0446\u0435\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
    \u0434\u043B\u044F \u043D\u0435\u043F\u0440\u043E\u0445\u0430\u043D\u0438\u0445
    \u0433\u043E\u0441\u0442\u0435\u0439."
  choices:
  - answerText: "\u0414\u043E\u0431\u0440\u0435, \u044F \u0432\u0441\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043A\u0430\u0436\u0438 \u043C\u043E\u0454
      \u043B\u0456\u0436\u043A\u043E."
    nextNode: {fileID: 11400000, guid: 15fcbd150bbde724ea0c96ac8fb5eba8, type: 2}
  - answerText: "\u041C\u0456\u0442\u043E, \u043D\u0430\u043F\u0435\u0432\u043D\u043E
      \u0442\u0432\u043E\u0454 \"\u043E\u0447\u0438\u0449\u0435\u043D\u043D\u044F\"
      \u043E\u043C\u0438\u043D\u0443\u043B\u043E \u0433\u043E\u043B\u043E\u0432\u0443."
    nextNode: {fileID: 11400000, guid: 552cff5f60a663a49af7a5c735d02865, type: 2}
