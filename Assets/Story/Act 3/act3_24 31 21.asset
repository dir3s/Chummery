  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u0414\u043E\u0441\u0438\u0442\u044C, \u041C\u0456\u0442\u043E!
    \u0422\u0432\u0456\u0439 \u0441\u0430\u0440\u043A\u0430\u0437\u043C \u0443\u0436\u0435
    \u043D\u0430\u0432\u0456\u0442\u044C \u043C\u0435\u043D\u0456 \u043D\u0430\u0431\u0440\u0438\u0434.
    \u0425\u043B\u043E\u043F\u0435\u0446\u044C \u043B\u0435\u0434\u044C \u043D\u0430
    \u043D\u043E\u0433\u0430\u0445 \u0441\u0442\u043E\u0457\u0442\u044C \u0432\u0456\u0434
    \u0443\u0442\u043E\u043C\u0438, \u0430 \u0442\u0438 \u0437\u0430\u043C\u0456\u0441\u0442\u044C
    \u0442\u043E\u0433\u043E, \u0449\u043E\u0431 \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u0438
    \u0439\u043E\u0433\u043E, \u0447\u0438\u0442\u0430\u0454\u0448 \u043D\u043E\u0442\u0430\u0446\u0456\u0457
    \u043F\u0440\u043E \u0456\u0440\u043E\u043D\u0456\u044E. \u0414\u0430\u0439 \u0439\u043E\u043C\u0443
    \u0441\u043F\u043E\u043A\u0456\u0439\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0443\u043F\u0438\u0442\u0438
    \u043F\u043E\u0440\u0456\u0433, \u0432\u0456\u043D \u043D\u0430\u0448 \u043D\u043E\u0432\u0438\u0439
    \u0441\u0443\u0441\u0456\u0434, \u0430 \u043D\u0435 \u0432\u043E\u0440\u043E\u0433!"
