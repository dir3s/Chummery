  m_Name: act3_24 31 22
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  nodeID: 73
  speakerName: "\u041C\u0456\u0442\u0430"
  background: {fileID: 4815371488780361518, guid: 5d47f979b6224034ebd1ecd37858539d, type: 3}
  dialogueText: "\u0426\u0456\u043D\u0443\u0439 \u0434\u043E\u0431\u0440\u043E\u0442\u0443
    \u0410\u043B\u0456. \u0426\u0435 \u0454\u0434\u0438\u043D\u0435, \u0449\u043E
    \u0437\u0430\u0432\u0430\u0436\u0430\u0454 \u043C\u0435\u043D\u0456 \u0441\u0442\u0435\u0440\u0442\u0438
    \u0442\u0432\u043E\u044E \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C
    \u043F\u0440\u044F\u043C\u043E \u0437\u0430\u0440\u0430\u0437. \u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F
    \u0441\u0442\u0430\u0442\u0438 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0438\u043C,
    \u043F\u043E\u043A\u0438 \u044F \u043D\u0435 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
    \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0438\u0442\u0438 \u0442\u0432\u043E\u0454
    \u043D\u0435\u043C\u0438\u043D\u0443\u0447\u0435 \u0437\u043D\u0438\u043A\u043D\u0435\u043D\u043D\u044F..."
  choices:
  - answerText: "\u0414\u043E\u0431\u0440\u0435, \u044F \u0432\u0441\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043A\u0430\u0436\u0438 \u043C\u043E\u0454
      \u043B\u0456\u0436\u043A\u043E."
    nextNode: {fileID: 11400000, guid: 15fcbd150bbde724ea0c96ac8fb5eba8, type: 2}
  - answerText: "\u041C\u0456\u0442\u043E, \u0437\u0430\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F,
      \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u0432\u0434\u0430\u043B\u043E
      \u043F\u043E\u0436\u0430\u0440\u0442\u0443\u0432\u0430\u0432."
    nextNode: {fileID: 11400000, guid: 16de2b901e9a2eb4dac03ab582763800, type: 2}
  - answerText: "\u041C\u0456\u0442\u043E, \u043D\u0430\u043F\u0435\u0432\u043D\u043E
      \u0442\u0432\u043E\u0454 \xAB\u043E\u0447\u0438\u0449\u0435\u043D\u043D\u044F\xBB
      \u0434\u043E \u0433\u043E\u043B\u043E\u0432\u0438 \u0449\u0435 \u043D\u0435
      \u0434\u0456\u0439\u0448\u043B\u043E."
    nextNode: {fileID: 11400000, guid: 552cff5f60a663a49af7a5c735d02865, type: 2}
