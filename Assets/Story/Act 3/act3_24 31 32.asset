  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\xAB\u0420\u0435\u043F\u0435\u0442\u0438\u0440\u0443\u0432\u0430\u043B\u0430\xBB?
    \u0422\u0438 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0432\u0432\u0430\u0436\u0430\u0454\u0448,
    \u0449\u043E \u0442\u0432\u043E\u044F \u043D\u0456\u043A\u0447\u0435\u043C\u043D\u0430
    \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C \u0432\u0430\u0440\u0442\u0430
    \u0431\u043E\u0434\u0430\u0439 \u0441\u0435\u043A\u0443\u043D\u0434\u0438 \u043C\u043E\u0454\u0457
    \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438? \u0422\u0432\u043E\u044F
    \u0437\u0430\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0456\u0441\u0442\u044C
    \u2014 \u0446\u0435 \u043B\u0438\u0448\u0435 \u0449\u0435 \u043E\u0434\u0438\u043D
    \u0432\u0438\u0434 \u0431\u0440\u0443\u0434\u0443, \u044F\u043A\u0438\u0439 \u043C\u0435\u043D\u0456
    \u0434\u043E\u0432\u0435\u0434\u0435\u0442\u044C\u0441\u044F \u0432\u0438\u0447\u0438\u0449\u0430\u0442\u0438
    \u0437\u0432\u0456\u0434\u0441\u0438 \u0440\u0430\u0437\u043E\u043C \u0456\u0437
    \u0442\u043E\u0431\u043E\u044E. "
