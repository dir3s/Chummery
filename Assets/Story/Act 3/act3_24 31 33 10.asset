  speakerName: "\u041C\u0456\u0442\u0430"
  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\"\u0412\u0441\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432\"?
    \u0422\u0438 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0434\u0443\u043C\u0430\u0454\u0448,
    \u0449\u043E \u043C\u043E\u0436\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0442\u0438 \u043D\u0430 \u0433\u0430\u043B\u044C\u043C\u0430,
    \u043A\u043E\u043B\u0438 \u0442\u0438 \u0432\u0436\u0435 \u0437\u043B\u0435\u0442\u0456\u0432
    \u0443 \u043F\u0440\u0456\u0440\u0432\u0443? \u0422\u0432\u043E\u0454 \"\u0434\u043E\u0431\u0440\u0435\"
    \u0437\u0430\u043F\u0456\u0437\u043D\u0438\u043B\u043E\u0441\u044F \u0440\u0456\u0432\u043D\u043E
    \u043D\u0430 \u043E\u0434\u043D\u0443 \u0440\u0435\u043F\u043B\u0456\u043A\u0443.
    \u041B\u0456\u0436\u043A\u043E \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E
    \u043F\u0440\u043E\u0441\u0438\u0442\u0438 \u0434\u043E \u0442\u043E\u0433\u043E,
    \u044F\u043A \u0442\u0438 \u0432\u0438\u0440\u0456\u0448\u0438\u0432 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438
    \u043C\u043E\u0454 \u0442\u0435\u0440\u043F\u0456\u043D\u043D\u044F. \u0422\u0435\u043F\u0435\u0440
    \u0441\u043E\u043D \u2014 \u0446\u0435 \u0440\u043E\u0437\u043A\u0456\u0448,
    \u044F\u043A\u0443 \u0442\u0438 \u0432\u0442\u0440\u0430\u0442\u0438\u0432..."
