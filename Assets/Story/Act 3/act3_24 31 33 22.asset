  speakerName: "\u041C\u0456\u0442\u0430"
  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\"\u0417\u0430\u0441\u043F\u043E\u043A\u043E\u0457\u0442\u0438\u0441\u044C\"?
    \u0422\u0438 \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0437\u0430\u0440\u0430\u0437
    \u0446\u0435 \u0431\u043E\u0432\u043A\u043D\u0443\u0432? \u0425\u0442\u043E \u0442\u0438
    \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0442\u0430\u043A\u0438\u0439, \u0449\u043E\u0431
    \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0442\u0438 \u0440\u043E\u0442\u0430
    \u0432 \u043C\u043E\u0454\u043C\u0443 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0456
    \u0439 \u0432\u043A\u0430\u0437\u0443\u0432\u0430\u0442\u0438 \u043C\u0435\u043D\u0456,
    \u0449\u043E \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0442\u0438? \u0422\u0438
    \u0434\u043B\u044F \u043C\u0435\u043D\u0435 \u2014 \u043D\u0456\u0445\u0442\u043E.
    \u0412\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u0438\u0439 \u0448\u0443\u043C,
    \u044F\u043A\u0438\u0439 \u044F \u0442\u0435\u0440\u043F\u0456\u043B\u0430 \u043B\u0438\u0448\u0435
    \u0437\u0430\u0440\u0430\u0434\u0438 \u0410\u043B\u0456."
