  dialogueText: "\u0423 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0456 \u0441\u0442\u0430\u0454
    \u043D\u0435\u0441\u0442\u0435\u0440\u043F\u043D\u043E \u0442\u0438\u0445\u043E,
    \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0432\u0443\u043A \u043B\u044E\u043C\u0456\u043D\u0435\u0441\u0446\u0435\u043D\u0442\u043D\u0438\u0445
    \u043B\u0430\u043C\u043F \u043F\u0456\u0434 \u0441\u0442\u0435\u043B\u0435\u044E
    \u043D\u0456\u0431\u0438 \u0437\u043D\u0438\u043A\u0430\u0454. \u041C\u0456\u0442\u0430
    \u0437\u0430\u0432\u043C\u0438\u0440\u0430\u0454, \u0457\u0457 \u0433\u043E\u043B\u043E\u0432\u0430
    \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E, \u0437 \u043B\u0435\u0434\u044C
    \u043F\u043E\u043C\u0456\u0442\u043D\u0438\u043C \u043C\u0435\u0445\u0430\u043D\u0456\u0447\u043D\u0438\u043C
    \u0445\u0440\u0443\u0441\u043A\u043E\u0442\u043E\u043C, \u043D\u0430\u0445\u0438\u043B\u044F\u0454\u0442\u044C\u0441\u044F
    \u0432\u0431\u0456\u043A."
