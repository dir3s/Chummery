  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u0407\u0457 \u0434\u0438\u0445\u0430\u043D\u043D\u044F \u0441\u0442\u0430\u0454
    \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u0456 \u0441\u0432\u0438\u0441\u0442\u044F\u0447\u0438\u043C,
    \u0430 \u043D\u0430 \u0449\u043E\u043A\u0430\u0445 \u0432\u0438\u0441\u0442\u0443\u043F\u0430\u044E\u0442\u044C
    \u044F\u0441\u043A\u0440\u0430\u0432\u0456 \u0447\u0435\u0440\u0432\u043E\u043D\u0456
    \u043F\u043B\u044F\u043C\u0438 \u043B\u044E\u0442\u0456. \u0407\u0457 \u043D\u0438\u0436\u043D\u044F
    \u043F\u043E\u0432\u0456\u043A\u0430 \u043F\u043E\u0447\u0438\u043D\u0430\u0454
    \u0434\u0440\u0456\u0431\u043D\u043E \u0442\u0440\u0435\u043C\u0442\u0456\u0442\u0438,
    \u0430 \u043F\u043E\u0433\u043B\u044F\u0434 \u0441\u0442\u0430\u0454 \u0432\u0430\u0436\u043A\u0438\u043C,
    \u043D\u0430\u043B\u0438\u0442\u0438\u043C \u044F\u043A\u043E\u044E\u0441\u044C
    \u0434\u0438\u043A\u043E\u044E, \u043C\u0430\u0439\u0436\u0435 \u0437\u0432\u0456\u0440\u044F\u0447\u043E\u044E
    \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u044E. \n\u0412\u043E\u043D\u0430
    \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u0434\u0438\u0432\u0438\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0442\u0435\u0431\u0435 \u0437\u0432\u0435\u0440\u0445\u0443 \u0432\u043D\u0438\u0437
    \u2014 \u0432\u043E\u043D\u0430 \u0434\u0438\u0432\u0438\u0442\u044C\u0441\u044F
    \u0442\u0430\u043A, \u043D\u0456\u0431\u0438 \u0432\u0436\u0435 \u0440\u043E\u0437\u0440\u0438\u0432\u0430\u0454
    \u0442\u0435\u0431\u0435 \u043D\u0430 \u0448\u043C\u0430\u0442\u043A\u0438."
