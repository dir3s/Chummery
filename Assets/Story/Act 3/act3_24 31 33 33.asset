  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u041C\u0456\u0442\u0430 \u043C\u043E\u0432\u0447\u043A\u0438 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0454
    \u0440\u0443\u043A\u0443 \u0432 \u043A\u0438\u0448\u0435\u043D\u044E \u0444\u0430\u0440\u0442\u0443\u0445\u0430.
    \u0422\u0438 \u0447\u0443\u0454\u0448 \u0440\u0456\u0437\u043A\u0438\u0439, \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0439
    \u0441\u043A\u0440\u0435\u0433\u0456\u0442, \u043D\u0430\u0447\u0435 \u0449\u043E\u0441\u044C
    \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F.
    \u0412\u043E\u043D\u0430 \u0434\u0456\u0441\u0442\u0430\u0454 \u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0441\u044C\u043A\u0438\u0439
    \u043D\u0456\u0436, \u0432\u0438\u0441\u0443\u0432\u0430\u044E\u0447\u0438 \u0434\u043E\u0432\u0433\u0435
    \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u043E\u0432\u0430\u043D\u0435 \u043B\u0435\u0437\u043E,
    \u044F\u043A\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E \u0431\u043B\u0438\u0449\u0438\u0442\u044C
    \u0443 \u043D\u0430\u043F\u0456\u0432\u0442\u0435\u043C\u0440\u044F\u0432\u0456
    \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443."
