  m_Script: {fileID: 11500000, guid: ba63bcbb05a29ce4fa79d24819a76077, type: 3}
  m_Name: act3_24 31
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  nodeID: 68
  speakerName: "\u0410\u043B\u044F"
  background: {fileID: -2301900891250477048, guid: e697014f873771f4ab1250b49c05eeaf, type: 3}
  dialogueText: "\u041C\u0456\u0442\u043E, \u043F\u0440\u0438\u043F\u0438\u043D\u0438!
    \u041B\u044E\u0434\u0438\u043D\u0430 \u0442\u0456\u043B\u044C\u043A\u0438 \u0437
    \u0434\u043E\u0440\u043E\u0433\u0438, \u0432\u0456\u043D \u0432\u0442\u043E\u043C\u043B\u0435\u043D\u0438\u0439
    \u0456 \u0449\u0435 \u043D\u0435 \u0432\u0456\u0434\u0456\u0439\u0448\u043E\u0432
    \u0432\u0456\u0434 \u0446\u044C\u043E\u0433\u043E \u043C\u0456\u0441\u0446\u044F,
    \u0430 \u0442\u0438 \u043D\u0430 \u043D\u044C\u043E\u0433\u043E \u043D\u0430\u043A\u0438\u043D\u0443\u043B\u0430\u0441\u044C,
    \u043D\u0456\u0431\u0438 \u0432\u0456\u043D \u0442\u043E\u0431\u0456 \u0432 \u0434\u0443\u0448\u0443
    \u043D\u0430\u043F\u043B\u044E\u0432\u0430\u0432. \u0414\u0430\u0439 \u0439\u043E\u043C\u0443
    \u0445\u043E\u0447\u0430 \u0431 \u0440\u0435\u0447\u0456 \u0437\u0430\u043D\u0435\u0441\u0442\u0438,
    \u0430 \u0442\u043E \u0437 \u043F\u043E\u0440\u043E\u0433\u0443 \u043F\u0440\u043E\u0436\u0430\u0440\u043A\u0443
    \u0432\u043B\u0430\u0448\u0442\u043E\u0432\u0443\u0454\u0448!"
  choices:
  - answerText: "\u0414\u044F\u043A\u0443\u044E, \u0410\u043B\u044E. \u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
      \u043C\u0435\u043D\u0456 \u0442\u0443\u0442 \u043D\u0435 \u0434\u0443\u0436\u0435
      \u0440\u0430\u0434\u0456"
    nextNode: {fileID: 11400000, guid: af86b1bc12ab60e4e8306b09a8c3cc3a, type: 2}
  - answerText: "\u0412\u043E\u043D\u0430 \u0449\u0435 \xAB\u043C\u0438\u043B\u0456\u0448\u0430\xBB,
      \u043D\u0456\u0436 \u044F \u0434\u0443\u043C\u0430\u0432."
    nextNode: {fileID: 11400000, guid: a11ec84da74bde741ab30c502d27a2d1, type: 2}
  - answerText: "\u041C\u0456\u0442\u043E, \u0442\u0432\u043E\u044F \u043F\u0440\u043E\u043C\u043E\u0432\u0430
      \u0432\u0440\u0430\u0436\u0430\u0454. \u0421\u043A\u0456\u043B\u044C\u043A\u0438
      \u0440\u0430\u0437\u0456\u0432 \u0440\u0435\u043F\u0435\u0442\u0438\u0440\u0443\u0432\u0430\u043B\u0430?"
    nextNode: {fileID: 11400000, guid: 2a591839db240cf428be6b3ca2558162, type: 2}
