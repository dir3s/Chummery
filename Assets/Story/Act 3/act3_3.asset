  background: {fileID: -5215294921018556061, guid: e44e9f93ca2782447a8cb996ed73fc47, type: 3}
  dialogueText: "\u0413\u0435\u0439... \u0422\u0438 \u0442\u0430\u043C \u0449\u0435
    \u043D\u0435 \u0437\u0430\u0446\u0456\u043F\u0435\u043D\u0456\u0432? \u0410 \u0442\u043E
    \u0432 \u0442\u0435\u0431\u0435 \u0442\u0430\u043A\u0438\u0439 \u0432\u0438\u0433\u043B\u044F\u0434
    \u0443 \u0446\u0456\u0439 \u043D\u0430\u043F\u0456\u0432\u0442\u0435\u043C\u0440\u044F\u0432\u0456,
    \u043D\u0456\u0431\u0438 \u0442\u0438 \u0437\u0430\u0440\u0430\u0437 \u0430\u0431\u043E
    \u0432 \u043E\u0431\u043C\u043E\u0440\u043E\u043A \u0443\u043F\u0430\u0434\u0435\u0448,
    \u0430\u0431\u043E \u0440\u043E\u0437\u0432\u0435\u0440\u043D\u0435\u0448\u0441\u044F
    \u0456 \u0434\u0430\u0441\u0438 \u0434\u044C\u043E\u0440\u0443 \u0430\u0436 \u0434\u043E
    \u0441\u0430\u043C\u043E\u0433\u043E \u0432\u043E\u043A\u0437\u0430\u043B\u0443."
  choices:
  - answerText: "\u0412\u0441\u0435 \u043E\u043A\u0435\u0439, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0440\u043E\u0445\u0438 \u043D\u0435 \u043F\u043E \u0441\u043E\u0431\u0456"
    nextNode: {fileID: 11400000, guid: 426ab7fbe45b3f44b84a39d0f6fd240c, type: 2}
  - answerText: "\u0429\u043E\u0441\u044C \u0447\u0438\u043C \u0434\u0430\u043B\u0456
      \u043C\u0438 \u0437\u0430\u0445\u043E\u0434\u0438\u043C\u043E \u0442\u0438\u043C
      \u043C\u043E\u0442\u043E\u0448\u043D\u0456\u0448\u0435"
    nextNode: {fileID: 11400000, guid: d1b3027afc1f3504b842899a435fc63f, type: 2}
