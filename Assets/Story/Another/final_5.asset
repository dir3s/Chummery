  background: {fileID: 3763606072375150839, guid: b9ed4c6a9f871564e84e61728a24aa35, type: 3}
  dialogueText: "\u0411\u0456\u043B\u044C \u0443 \u043F\u043B\u0435\u0447\u0456 \u043F\u0443\u043B\u044C\u0441\u0443\u0454
    \u0432 \u0442\u0430\u043A\u0442 \u0456\u0437 \u0448\u0430\u043B\u0435\u043D\u0438\u043C
    \u0443\u0434\u0430\u0440\u0430\u043C\u0438 \u0441\u0435\u0440\u0446\u044F. \u0425\u043E\u043B\u043E\u0434\u043D\u0438\u0439,
    \u043C\u043E\u043A\u0440\u0438\u0439 \u043F\u0456\u0441\u043B\u044F \u0434\u043E\u0449\u0443
    \u0434\u0430\u0445 \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0454\u0434\u0438\u043D\u043E\u044E
    \u0442\u0432\u0435\u0440\u0434\u0438\u043D\u0435\u044E \u0432 \u0446\u044C\u043E\u043C\u0443
    \u0441\u0432\u0456\u0442\u0456, \u0449\u043E \u0440\u0443\u0439\u043D\u0443\u0454\u0442\u044C\u0441\u044F.
    \u0413\u043B\u0438\u0431\u043E\u043A\u0435, \u043D\u0435\u043C\u043E\u0432 \u0437\u0430\u0441\u0442\u0438\u0433\u043B\u0430
    \u043A\u0440\u043E\u0432, \u043F\u0443\u0440\u043F\u0443\u0440\u043E\u0432\u0435
    \u043D\u0435\u0431\u043E \u0442\u0438\u0441\u043D\u0435 \u0437\u0432\u0435\u0440\u0445\u0443,
    \u0430 \u0441\u043E\u043D\u0446\u0435, \u0449\u043E \u0441\u0456\u0434\u0430\u0454,
    \u0437\u0430\u043B\u0438\u0432\u0430\u0454 \u043C\u0456\u0441\u0442\u043E \u0437\u043B\u043E\u0432\u0456\u0441\u043D\u0438\u043C
    \u043F\u043E\u043C\u0430\u0440\u0430\u043D\u0447\u0435\u0432\u0438\u043C \u0441\u0432\u0456\u0442\u043B\u043E\u043C."
