  background: {fileID: 1764473273360804482, guid: 13677c6aa72c91c4a917152ab56dccca, type: 3}
  dialogueText: "\u0414\u043E\u0449 \u043F\u043E\u0441\u0438\u043B\u044E\u0454\u0442\u044C\u0441\u044F,
    \u0440\u043E\u0437\u043C\u0438\u0432\u0430\u044E\u0447\u0438 \u043A\u0440\u0438\u0432\u0430\u0432\u0435
    \u043F\u0443\u0440\u043F\u0443\u0440\u043E\u0432\u0435 \u043D\u0435\u0431\u043E
    \u0442\u0430 \u0437\u043B\u0438\u0432\u0430\u044E\u0447\u0438 \u0432\u0441\u0435
    \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u0432 \u043E\u0434\u043D\u0443 \u0441\u0456\u0440\u0443
    \u0441\u043C\u0443\u0433\u0443. \u0412\u043E\u043D\u0430 \u0431\u0456\u043B\u044C\u0448\u0435
    \u043D\u0435 \u043F\u043E\u0441\u043C\u0456\u0445\u0430\u0454\u0442\u044C\u0441\u044F;
    \u0457\u0457 \u043E\u0447\u0456 \u043C\u0430\u0439\u0436\u0435 \u0437\u0430\u043F\u043B\u044E\u0449\u0435\u043D\u0456,
    \u0430 \u043D\u0456\u0436 \u043B\u0435\u0436\u0438\u0442\u044C \u043F\u043E\u0440\u0443\u0447."
